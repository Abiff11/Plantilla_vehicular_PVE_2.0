# Runtime
NODE_ENV=development
PORT=3101
HOST=0.0.0.0
TRUST_PROXY=false

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vehicle_control
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me_only_for_local
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_MIGRATIONS_RUN=false

# JWT
# Production requires at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change_me_only_for_local_jwt_secret_32_chars
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_IMPORT_MAX_REQUESTS=20

# CORS
# Comma-separated frontend origins allowed by CORS and WebSocket CORS.
# Production must use real HTTPS origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Superadmin seed account
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
SUPERADMIN_GRADE=
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Storage
# local = guarda archivos en /uploads
# r2 = guarda archivos en Cloudflare R2
STORAGE_DRIVER=local

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
