# Root environment used by docker-compose.service.yml
# Copy this file to .env and set real values outside Git.
# Never commit .env with real secrets.

# Runtime
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512
APP_NAME=plantilla_vehicular
HOST=0.0.0.0
PORT=3101
TRUST_PROXY=true

# Frontend route behind central Nginx VPN entrypoint
# Public VPN URL: http://100.118.154.7/plantilla-vehicular/
VITE_BASE_PATH=/plantilla-vehicular/
VITE_API_URL=/plantilla-vehicular/api
VITE_SOCKET_URL=/
VITE_SOCKET_PATH=/plantilla-vehicular/socket.io

# CORS
# Production must be limited to the VPN web origin from the server sheet.
FRONTEND_ORIGINS=http://100.118.154.7

# Central PostgreSQL managed by /opt/intranet/infra
# Real database secrets live in:
# /opt/intranet/infra/security/plantilla_vehicular.db.env
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=plantilla_vehicular_db
DATABASE_USER=plantilla_vehicular_user
DATABASE_PASSWORD=NO_SUBIR_PASSWORD_REAL
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_MIGRATIONS_RUN=false

# PostgreSQL connection pool
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_MAX_QUERY_EXECUTION_TIME=500

# API workload limits
API_MAX_PAGE_SIZE=100
HEAVY_REQUEST_CONCURRENCY=2

# TypeORM query cache. Keep disabled by default for sensitive data.
CACHE_QUERY_ENABLED=false
CACHE_QUERY_DURATION_MS=30000

# Auth
JWT_SECRET=NO_SUBIR_SECRET_REAL_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_IMPORT_MAX_REQUESTS=20

# Superadmin bootstrap
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
SUPERADMIN_GRADE=
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional seed password for generated users
SEED_USERS_PASSWORD=

# Storage
# Production requires Cloudflare R2. Use local only for development.
STORAGE_DRIVER=r2

# Cloudflare R2
# Account ID: Cloudflare dashboard URL, not the bucket name.
# Access keys: R2 > Manage R2 API Tokens > Create API token.
# Public URL is optional. If empty, the backend serves files through /api/files/*.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
