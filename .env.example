# Root environment used by docker-compose.prod.yml
# Copy this file to .env and set real values outside Git.

# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3101
TRUST_PROXY=true

# Public frontend binding exposed only to the host reverse proxy
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8087

# Frontend build-time URLs
VITE_API_URL=/api
VITE_SOCKET_URL=/

# CORS
# Production must use real HTTPS origins. Example: https://plantilla.sisoaxaca.com
FRONTEND_ORIGINS=

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=vehicle_control
DATABASE_USER=vehicle_control_user
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_MIGRATIONS_RUN=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_IMPORT_MAX_REQUESTS=20

# Superadmin bootstrap
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
SUPERADMIN_GRADE=
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional seed password for generated users
SEED_USERS_PASSWORD=

# Storage: local or r2
STORAGE_DRIVER=local

# Cloudflare R2 only when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
