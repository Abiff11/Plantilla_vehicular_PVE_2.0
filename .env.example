# Root environment used by docker-compose.yml
# Copy this file to .env and set real values outside Git.

# Server
HOST=0.0.0.0
TRUST_PROXY=false
FRONTEND_ORIGIN=http://localhost
FRONTEND_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80,http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=vehicle_control
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000

# Superadmin bootstrap
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
SUPERADMIN_GRADE=
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional seed password for generated users
SEED_USERS_PASSWORD=

# Storage: local or r2
STORAGE_DRIVER=local

# Cloudflare R2 only when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
