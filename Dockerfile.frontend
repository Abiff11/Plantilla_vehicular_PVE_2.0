# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend ./

ARG VITE_BASE_PATH=/plantilla-vehicular/
ARG VITE_API_URL=/plantilla-vehicular/api
ARG VITE_SOCKET_URL=/
ARG VITE_SOCKET_PATH=/plantilla-vehicular/socket.io
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}
ENV VITE_SOCKET_PATH=${VITE_SOCKET_PATH}

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

COPY --from=builder --chown=101:0 /app/frontend/dist /usr/share/nginx/html
COPY --chown=101:0 frontend/nginx.conf /etc/nginx/conf.d/default.conf

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/robots.txt >/dev/null || exit 1
